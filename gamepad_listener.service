[Unit]
Description=G1 Gamepad Listener Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__CONDA_PYTHON__ __PROJECT_DIR__/robojudo_listener.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
