[Unit]
Description=G1 Gamepad Listener Service (User Level)
After=network.target

[Service]
Type=forking
User=__USER__
Group=__USER__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/start_gamepad_listener.sh start
ExecStop=__PROJECT_DIR__/start_gamepad_listener.sh stop
ExecReload=__PROJECT_DIR__/start_gamepad_listener.sh restart
PIDFile=__PROJECT_DIR__/gamepad_listener.pid
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
